# Copiez ce fichier en .env et renseignez vos valeurs.
# .env est ignoré par git : il ne doit jamais être commité.

# Clé API Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Modèle Gemini utilisé pour l'analyse de peau et le chat.
# Optionnel : si absent, l'application utilise gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Modèles de repli, séparés par des virgules, essayés automatiquement quand
# le modèle principal reste saturé (HTTP 503) après plusieurs tentatives.
# Optionnel : si absent, l'application utilise gemini-3.6-flash
# puis gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite

# Clé publique Notch Pay pour l'abonnement aux dermatologues
# (Business Suite > Settings > API Keys). En mode test elle commence par
# pk_test_ : aucun argent réel n'est débité. Jamais la clé privée ici.
NOTCHPAY_PUBLIC_KEY=your_notchpay_public_key_here
